# Public (safe for browser)
# Project URL only — do NOT append /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only — never prefix with NEXT_PUBLIC_
# Use the service_role secret (or new sb_secret_ key). Never commit real values.
# Required on Vercel for activity logging, product cache, admin/cron paths.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Vercel performance: deploy region is bom1 (Mumbai). Create the Supabase project
# in Mumbai (ap-south-1) so API latency stays low. Mismatched regions often add 1–3s.

# Optional — WhatsApp Cloud API (Meta). When set, Send delivers without opening wa.me.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v21.0
